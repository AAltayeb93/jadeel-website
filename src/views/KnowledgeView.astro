---
import type { Locale } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTABand from "../components/CTABand.astro";
import Icon from "../components/Icon.astro";
import { content } from "../data/content";
import { ui } from "../data/site";
import { getCollection } from "astro:content";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const t = ui[locale];
const k = c.knowledge;

const all = await getCollection("articles", (a) => a.data.locale === locale);
const articles = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat(locale === "ar" ? "ar-SA" : "en-GB", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout locale={locale} route="knowledge" title={c.meta.knowledge.title} description={c.meta.knowledge.desc}>
  <PageHero eyebrow={k.hero.eyebrow} title={k.hero.title} lead={k.hero.lead} />

  <section class="section">
    <div class="container">
      <div class="grid grid-3 article-grid">
        {articles.map((a) => (
          <article class="art-card reveal">
            <div class="art-top">
              {a.data.category && <span class="art-cat">{a.data.category}</span>}
              <span class="art-read"><Icon name="clock" size={14} />{a.data.readingTime}</span>
            </div>
            <h3>{a.data.title}</h3>
            <p>{a.data.description}</p>
            <div class="art-foot">
              <time datetime={a.data.date.toISOString()}>{fmt.format(a.data.date)}</time>
              <span class="art-more">{t.readMore}<Icon name="arrow-left" size={16} /></span>
            </div>
          </article>
        ))}
      </div>
      {articles.length === 0 && (
        <p class="text-center lead">{locale === "ar" ? "قريبًا: مقالات ورؤى عملية." : "Coming soon: practical articles and insights."}</p>
      )}
    </div>
  </section>

  <CTABand locale={locale} title={c.home.finalCta.title} text={c.home.finalCta.text} />
</BaseLayout>

<style>
  .art-card { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--border); border-radius: var(--r-card); padding: var(--s6); box-shadow: var(--shadow-sm); transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .art-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .art-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s3); margin-bottom: var(--s4); }
  .art-cat { background: var(--gold-050); color: var(--gold-600); font-size: 0.78rem; font-weight: 700; padding: 5px 12px; border-radius: var(--r-pill); }
  .art-read { display: inline-flex; align-items: center; gap: 5px; color: var(--text-muted); font-size: 0.8rem; }
  .art-card h3 { font-size: 1.25rem; margin-bottom: var(--s3); }
  .art-card > p { color: var(--text-muted); font-size: 0.95rem; flex: 1; }
  .art-foot { display: flex; align-items: center; justify-content: space-between; margin-top: var(--s5); padding-top: var(--s4); border-top: 1px solid var(--border); }
  .art-foot time { color: var(--slate); font-size: 0.85rem; }
  .art-more { display: inline-flex; align-items: center; gap: 6px; color: var(--green-700); font-weight: 600; font-size: 0.9rem; }
  :global(:root[dir="ltr"]) .art-more :global(svg) { transform: scaleX(-1); }
</style>
