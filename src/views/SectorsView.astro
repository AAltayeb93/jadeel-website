---
import type { Locale } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTABand from "../components/CTABand.astro";
import Icon from "../components/Icon.astro";
import { content } from "../data/content";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const s = c.sectors;
---
<BaseLayout locale={locale} route="sectors" title={c.meta.sectors.title} description={c.meta.sectors.desc}>
  <PageHero eyebrow={s.hero.eyebrow} title={s.hero.title} lead={s.hero.lead} />

  <!-- Entities -->
  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">{s.entities.eyebrow}</span>
        <h2>{s.entities.title}</h2>
      </div>
      <div class="grid grid-4 ent-grid">
        {s.entities.items.map((e) => (
          <div class="ent-card reveal">
            <span class="card-icon"><Icon name={e.icon} /></span>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Domains -->
  <section class="section section--navy">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">{s.domains.eyebrow}</span>
        <h2>{s.domains.title}</h2>
      </div>
      <ul class="domains reveal">
        {s.domains.items.map((d) => (
          <li class="domain-chip"><span class="diamond"></span>{d}</li>
        ))}
      </ul>
    </div>
  </section>

  <CTABand locale={locale} title={c.home.finalCta.title} text={c.home.finalCta.text} />
</BaseLayout>

<style>
  .ent-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--r-card); padding: var(--s5); box-shadow: var(--shadow-sm); transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .ent-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .ent-card h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .ent-card p { color: var(--text-muted); font-size: 0.92rem; }

  .domains { display: flex; flex-wrap: wrap; gap: var(--s3); justify-content: center; max-width: 900px; margin-inline: auto; }
  .domain-chip {
    display: inline-flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
    color: #e6eefa; padding: 12px 20px; border-radius: var(--r-pill); font-weight: 500;
    transition: background 0.16s ease, border-color 0.16s ease;
  }
  .domain-chip:hover { background: rgba(190,140,58,0.16); border-color: var(--gold); }
</style>
