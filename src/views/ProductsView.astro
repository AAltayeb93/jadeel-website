---
import type { Locale } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CTABand from "../components/CTABand.astro";
import Icon from "../components/Icon.astro";
import { content } from "../data/content";
import { ui } from "../data/site";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = content[locale];
const t = ui[locale];
const p = c.products;
---
<BaseLayout locale={locale} route="products" title={c.meta.products.title} description={c.meta.products.desc}>
  <PageHero eyebrow={p.hero.eyebrow} title={p.hero.title} lead={p.hero.lead} />

  <section class="section">
    <div class="container">
      <div class="prod-list">
        {p.list.map((prod) => (
          <article class="prod-card reveal" id={prod.slug}>
            <header class="pc-head">
              <span class="card-icon"><Icon name={prod.icon} /></span>
              <div class="pc-title">
                {prod.featured && <span class="badge badge--featured">{locale === "ar" ? "مميز" : "Featured"}</span>}
                <h2>{prod.name}</h2>
                <p class="pc-summary">{prod.summary}</p>
              </div>
            </header>
            <div class="pc-body">
              <div class="pc-field">
                <span class="pc-label"><Icon name="users" size={16} />{t.forWhom}</span>
                <p>{prod.forWhom}</p>
              </div>
              <div class="pc-field">
                <span class="pc-label"><Icon name="search" size={16} />{t.problem}</span>
                <p>{prod.problem}</p>
              </div>
              <div class="pc-field pc-field--wide">
                <span class="pc-label"><Icon name="check" size={16} />{t.outputs}</span>
                <ul class="pc-outputs">
                  {prod.outputs.map((o) => (<li><span class="diamond"></span>{o}</li>))}
                </ul>
              </div>
              <div class="pc-meta">
                <div><span class="pc-label"><Icon name="clock" size={16} />{t.duration}</span><p>{prod.duration}</p></div>
                <div><span class="pc-label"><Icon name="arrow-left" size={16} />{t.nextStep}</span><p>{prod.nextStep}</p></div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABand locale={locale} title={c.home.finalCta.title} text={c.home.finalCta.text} />
</BaseLayout>

<style>
  .prod-list { display: flex; flex-direction: column; gap: var(--s6); }
  .prod-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--r-panel); padding: clamp(24px, 4vw, 40px); box-shadow: var(--shadow-sm); scroll-margin-top: 90px; transition: box-shadow 0.18s ease; }
  .prod-card:hover { box-shadow: var(--shadow-md); }
  .pc-head { display: flex; gap: var(--s4); align-items: flex-start; padding-bottom: var(--s5); border-bottom: 1px solid var(--border); margin-bottom: var(--s5); }
  .pc-head .card-icon { width: 60px; height: 60px; margin-bottom: 0; flex-shrink: 0; background: var(--navy); color: #fff; }
  .pc-head .card-icon :global(svg) { width: 30px; height: 30px; }
  .pc-title h2 { font-size: 1.6rem; }
  .pc-summary { margin-top: 6px; color: var(--text-muted); font-size: 1.05rem; }
  .pc-title .badge { margin-bottom: 8px; }

  .pc-body { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s5) var(--s7); }
  .pc-field--wide { grid-column: 1 / -1; }
  .pc-label { display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 700; color: var(--green-700); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 8px; }
  :global(:root[lang="ar"]) .pc-label { text-transform: none; letter-spacing: 0; font-size: 0.95rem; }
  .pc-label :global(svg) { color: var(--gold); }
  .pc-field p { color: var(--text); }
  .pc-outputs { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2) var(--s5); }
  .pc-outputs li { display: flex; gap: 10px; align-items: baseline; color: var(--text); }
  .pc-outputs .diamond { flex-shrink: 0; }
  .pc-meta { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s5) var(--s7); padding-top: var(--s5); border-top: 1px dashed var(--cloud); }

  @media (max-width: 760px) {
    .pc-body, .pc-outputs, .pc-meta { grid-template-columns: 1fr; }
  }
</style>
